// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PATIENT
  LAB_TECH
  PHARMACIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff?
  patient   Patient?
}

model Staff {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String
  lastName     String
  specialization String?
  contactNo    String?
  address      String?
  
  user         User     @relation(fields: [userId], references: [id])
  appointments Appointment[]
  consultations Consultation[]
  admissions   Admission[] @relation("AdmittingDoctor")
  nursingLogs  NursingLog[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Patient {
  id           String   @id @default(uuid())
  userId       String?  @unique
  firstName    String
  lastName     String
  dob          DateTime
  gender       Gender
  bloodGroup   String?
  contactNo    String
  address      String?
  
  user         User?    @relation(fields: [userId], references: [id])
  appointments Appointment[]
  consultations Consultation[]
  admissions   Admission[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id           String            @id @default(uuid())
  patientId    String
  doctorId     String
  appointmentDate DateTime
  reason       String?
  status       AppointmentStatus @default(SCHEDULED)
  tokenNumber  Int?

  patient      Patient           @relation(fields: [patientId], references: [id])
  doctor       Staff             @relation(fields: [doctorId], references: [id])
  consultation Consultation?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Consultation {
  id           String   @id @default(uuid())
  appointmentId String  @unique
  patientId    String
  doctorId     String
  
  // Vitals
  bloodPressure String?
  temperature   String?
  pulse         String?
  weight        String?
  
  // Clinical Notes
  symptoms     String
  diagnosis    String
  notes        String?
  
  appointment  Appointment @relation(fields: [appointmentId], references: [id])
  patient      Patient     @relation(fields: [patientId], references: [id])
  doctor       Staff       @relation(fields: [doctorId], references: [id])
  prescription Prescription?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Prescription {
  id             String   @id @default(uuid())
  consultationId String   @unique
  
  // JSON array of objects: [{ name: "Paracetamol", dosage: "500mg", frequency: "1-0-1", duration: "5 days" }]
  medicines      Json     
  
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Ward {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   // General, ICU, Semi-Private, Private
  beds      Bed[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bed {
  id        String    @id @default(uuid())
  bedNumber String
  wardId    String
  status    BedStatus @default(AVAILABLE)
  
  ward      Ward      @relation(fields: [wardId], references: [id])
  admission Admission?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@unique([wardId, bedNumber])
}

model Admission {
  id             String    @id @default(uuid())
  patientId      String
  bedId          String    @unique
  admittingDoctorId String
  admissionDate  DateTime  @default(now())
  dischargeDate  DateTime?
  reason         String
  status         String    @default("ADMITTED") // ADMITTED, DISCHARGED
  
  patient        Patient   @relation(fields: [patientId], references: [id])
  bed            Bed       @relation(fields: [bedId], references: [id])
  doctor         Staff     @relation("AdmittingDoctor", fields: [admittingDoctorId], references: [id])
  nursingLogs    NursingLog[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model NursingLog {
  id           String    @id @default(uuid())
  admissionId  String
  nurseId      String
  
  // Vitals
  bloodPressure String?
  temperature   String?
  pulse         String?
  spo2          String?
  
  notes        String
  
  admission    Admission @relation(fields: [admissionId], references: [id])
  nurse        Staff     @relation(fields: [nurseId], references: [id])

  createdAt    DateTime  @default(now())
}
