// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  PATIENT
  LAB_TECH
  PHARMACIST
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum LabRequestStatus {
  PENDING
  SAMPLE_COLLECTED
  RESULT_REPORTED
  CANCELLED
}

enum InvoiceStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  INSURANCE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff     Staff?
  patient   Patient?
}

model Staff {
  id           String   @id @default(uuid())
  userId       String   @unique
  firstName    String
  lastName     String
  specialization String?
  contactNo    String?
  address      String?
  consultationFee Float @default(0)
  
  user         User     @relation(fields: [userId], references: [id])
  appointments Appointment[]
  consultations Consultation[]
  admissions   Admission[] @relation("AdmittingDoctor")
  nursingLogs  NursingLog[]
  labRequests  LabRequest[] @relation("RequestingDoctor")
  labResults   LabResult[]  @relation("LabTechnician")
  pharmacySales PharmacySale[] @relation("Pharmacist")
  invoicesCreated Invoice[] @relation("InvoiceCreator")
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Patient {
  id           String   @id @default(uuid())
  userId       String?  @unique
  firstName    String
  lastName     String
  dob          DateTime
  gender       Gender
  bloodGroup   String?
  contactNo    String
  address      String?
  
  user         User?    @relation(fields: [userId], references: [id])
  appointments Appointment[]
  consultations Consultation[]
  admissions   Admission[]
  labRequests  LabRequest[]
  pharmacySales PharmacySale[]
  invoices      Invoice[]
  payments      Payment[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Appointment {
  id           String            @id @default(uuid())
  patientId    String
  doctorId     String
  appointmentDate DateTime
  reason       String?
  status       AppointmentStatus @default(SCHEDULED)
  tokenNumber  Int?

  patient      Patient           @relation(fields: [patientId], references: [id])
  doctor       Staff             @relation(fields: [doctorId], references: [id])
  consultation Consultation?

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model Consultation {
  id           String   @id @default(uuid())
  appointmentId String  @unique
  patientId    String
  doctorId     String
  
  // Vitals
  bloodPressure String?
  temperature   String?
  pulse         String?
  weight        String?
  
  // Clinical Notes
  symptoms     String
  diagnosis    String
  notes        String?
  
  appointment  Appointment @relation(fields: [appointmentId], references: [id])
  patient      Patient     @relation(fields: [patientId], references: [id])
  doctor       Staff       @relation(fields: [doctorId], references: [id])
  prescription Prescription?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Prescription {
  id             String   @id @default(uuid())
  consultationId String   @unique
  
  // JSON array of objects: [{ name: "Paracetamol", dosage: "500mg", frequency: "1-0-1", duration: "5 days" }]
  medicines      Json     
  
  consultation   Consultation @relation(fields: [consultationId], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// --- IPD Models ---

model Ward {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   // General, ICU, Semi-Private, Private
  beds      Bed[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Bed {
  id        String    @id @default(uuid())
  bedNumber String
  wardId    String
  status    BedStatus @default(AVAILABLE)
  
  ward      Ward      @relation(fields: [wardId], references: [id])
  admission Admission?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@unique([wardId, bedNumber])
}

model Admission {
  id             String    @id @default(uuid())
  patientId      String
  bedId          String    @unique
  admittingDoctorId String
  admissionDate  DateTime  @default(now())
  dischargeDate  DateTime?
  reason         String
  status         String    @default("ADMITTED") // ADMITTED, DISCHARGED
  
  patient        Patient   @relation(fields: [patientId], references: [id])
  bed            Bed       @relation(fields: [bedId], references: [id])
  doctor         Staff     @relation("AdmittingDoctor", fields: [admittingDoctorId], references: [id])
  nursingLogs    NursingLog[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model NursingLog {
  id           String    @id @default(uuid())
  admissionId  String
  nurseId      String
  
  // Vitals
  bloodPressure String?
  temperature   String?
  pulse         String?
  spo2          String?
  
  notes        String
  
  admission    Admission @relation(fields: [admissionId], references: [id])
  nurse        Staff     @relation(fields: [nurseId], references: [id])

  createdAt    DateTime  @default(now())
}

// --- Laboratory Models ---

model TestType {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   // Blood, Imaging, etc.
  cost        Float
  normalRange String?
  labRequests LabRequest[]
}

model LabRequest {
  id              String           @id @default(uuid())
  patientId       String
  requestingDoctorId String
  testTypeId      String
  status          LabRequestStatus @default(PENDING)
  notes           String?
  
  patient         Patient          @relation(fields: [patientId], references: [id])
  doctor          Staff            @relation("RequestingDoctor", fields: [requestingDoctorId], references: [id])
  testType        TestType         @relation(fields: [testTypeId], references: [id])
  result          LabResult?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model LabResult {
  id              String     @id @default(uuid())
  labRequestId    String     @unique
  technicianId    String
  resultData      Json       // { value: "140", unit: "mg/dL", observation: "Normal" }
  attachments     String?    // URL to report PDF or Image
  
  labRequest      LabRequest @relation(fields: [labRequestId], references: [id])
  technician      Staff      @relation("LabTechnician", fields: [technicianId], references: [id])

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// --- Pharmacy Models ---

model Medicine {
  id           String   @id @default(uuid())
  name         String   @unique
  brandName    String?
  category     String?
  dosageForm   String   // Tablet, Syrup, Injection
  unitPrice    Float
  stock        Int      @default(0)
  expiryDate   DateTime?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PharmacySale {
  id           String   @id @default(uuid())
  patientId    String?
  pharmacistId String
  totalAmount  Float
  
  // JSON array of items: [{ medicineId: "...", quantity: 2, price: 100 }]
  items        Json     
  
  patient      Patient? @relation(fields: [patientId], references: [id])
  pharmacist   Staff    @relation("Pharmacist", fields: [pharmacistId], references: [id])

  createdAt    DateTime @default(now())
}

// --- Billing Models ---

model Invoice {
  id           String        @id @default(uuid())
  patientId    String
  createdById  String        // Staff member who generated the invoice
  totalAmount  Float
  paidAmount   Float         @default(0)
  balanceAmount Float
  status       InvoiceStatus @default(PENDING)
  
  // JSON array of items: [{ description: "Consultation Fee", quantity: 1, unitPrice: 500, amount: 500 }]
  items        Json          
  
  patient      Patient       @relation(fields: [patientId], references: [id])
  createdBy    Staff         @relation("InvoiceCreator", fields: [createdById], references: [id])
  payments     Payment[]
  
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Payment {
  id           String        @id @default(uuid())
  invoiceId    String
  patientId    String
  amount       Float
  paymentMethod PaymentMethod
  transactionId String?      // For card/UPI transactions
  
  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  
  createdAt    DateTime      @default(now())
}

